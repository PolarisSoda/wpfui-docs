<UserControl x:Class="QuickStart.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    ui:NavigationView.HeaderContent="환경 설정">
    <StackPanel Margin="24">
        <ui:TextBlock Text="환경 설정" FontTypography="Title" Margin="0,0,0,16" />
        <ui:CardControl Header="알림" Icon="{ui:SymbolIcon Alert24}" Margin="0,0,0,12">
            <ui:ToggleSwitch OnContent="켜짐" OffContent="꺼짐" IsChecked="True" />
        </ui:CardControl>
        <ui:TextBox x:Name="UserName" PlaceholderText="표시 이름" Width="280"
            HorizontalAlignment="Left" Margin="0,0,0,12" />
        <ui:NumberBox x:Name="Quantity" Value="3" Minimum="0" Maximum="10"
            Width="200" HorizontalAlignment="Left" Margin="0,0,0,12" />
        <ui:AutoSuggestBox x:Name="City" PlaceholderText="도시 검색" Width="280"
            HorizontalAlignment="Left" Margin="0,0,0,16" />
        <ui:Button Content="저장 확인" Click="SaveClicked" HorizontalAlignment="Left"
            Appearance="Primary" Icon="{ui:SymbolIcon Save24}" />
    </StackPanel>
</UserControl>
